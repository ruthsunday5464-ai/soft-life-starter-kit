<meta name="description" content="Plug-and-play digital products + aesthetic guides to upgrade your lifestyle. Ready to implement, ready to sell.">
<title>Soft Life Starter Kit</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
<style>
/* Reset & Base */
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Open Sans',sans-serif;background:#fff;color:#111;line-height:1.6;}
h1,h2,h3,h4{font-family:'Playfair Display',serif;margin-bottom:.5em;}
a{text-decoration:none;color:inherit;}
img{max-width:100%;display:block;}
:root{--black:#111;--beige:#f5f0e7;--gold:#d4af37;}
.container{width:90%;max-width:1200px;margin:0 auto;}
.btn{display:inline-block;background:var(--gold);color:var(--black);padding:.75em 1.5em;font-weight:600;transition:.3s;}
.btn:hover{opacity:.8;}
.hero{display:flex;flex-direction:column-reverse;align-items:center;justify-content:center;padding:4em 0;text-align:center;opacity:0;transform:translateY(20px);animation:fadeIn 1s forwards;}
.hero h1{font-size:2.5em;margin-bottom:.5em;}
.hero p{font-size:1.25em;margin-bottom:1em;}
.hero img{width:100%;max-width:500px;border-radius:8px;margin-bottom:2em;}
.benefits{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:2em;margin:4em 0;}
.benefit-card{background:var(--beige);padding:2em;border-radius:12px;text-align:center;transition:transform .3s,opacity 1s;opacity:0;transform:translateY(20px);}
.benefit-card:hover{transform:translateY(-5px);}
.how-it-works{margin:4em 0;}
.steps{display:flex;flex-wrap:wrap;gap:2em;justify-content:space-between;}
.step{flex:1 1 220px;background:var(--beige);padding:2em;border-radius:12px;text-align:center;opacity:0;transform:translateY(20px);transition:opacity .6s,transform .6s;}
.testimonials{background:#f9f7f3;padding:4em 0;}
.testimonial{text-align:center;padding:1em;opacity:0;transform:translateY(20px);transition:opacity .6s,transform .6s;}
.testimonial img{border-radius:50%;width:80px;margin-bottom:1em;}
.products{margin:4em 0;display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:1em;padding-bottom:1em;}
.product{flex:0 0 300px;background:var(--beige);padding:2em;border-radius:12px;text-align:center;scroll-snap-align:center;opacity:0;transform:translateY(20px);transition:opacity .6s,transform .6s;}
.scarcity{background:var(--black);color:var(--gold);text-align:center;padding:4em 0;opacity:0;transform:translateY(20px);animation:fadeIn 1s forwards .5s;}
.scarcity h2{margin-bottom:1em;}
footer{background:var(--black);color:var(--gold);padding:2em 0;text-align:center;}
footer a{margin:0 .5em;color:var(--gold);}
@media(max-width:768px){.hero{padding:3em 1em;}.hero h1{font-size:2em;}.hero p{font-size:1.1em;}.steps{flex-direction:column;}}
@keyframes fadeIn{to{opacity:1;transform:translateY(0);}}
</style>
</head>
